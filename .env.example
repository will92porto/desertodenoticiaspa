# Secrets das Edge Functions (configurar com `supabase secrets set`)
GEMINI_API_KEY=<sua-chave-gemini>

# Injetadas automaticamente pelo Supabase nas functions (não precisa setar):
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY

# WordPress (Application Password). Pode ser global ou por projeto:
# o projeto referencia o NOME do secret em wordpress_app_password_secret.
WORDPRESS_APP_PASSWORD=<application-password-padrao>
# Exemplo por projeto:
# WP_APP_PW_PROJETO1=<application-password-do-projeto-1>
